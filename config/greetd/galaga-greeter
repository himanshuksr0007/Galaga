#!/bin/sh
# the galaga greeter face, then the compositor exits.
# Deployed to /etc/greetd/galaga-greeter by ./install.sh --greeter and started by
# the greeter's Hyprland (config/greetd/hyprland.lua). greetd hands the VT to the
# user session only after this greeter session ends, so when quickshell exits
# (Greetd.launch quits it after a successful login -- or it crashed), Hyprland
# must follow, or the login would hang on a black screen. If quickshell dies
# before any login, greetd simply restarts the whole greeter session.
qs -p /etc/greetd/galaga/greet.qml
hyprctl dispatch exit
